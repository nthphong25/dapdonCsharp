<Window  x:Class="dapdon.Views.MoSelectionView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="EPC Viewer"
 Width="400"
 Height="200"
      >

    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Chọn MO_NO:"/>
            <ComboBox ItemsSource="{Binding MoNoList}" 
                      SelectedItem="{Binding SelectedMoNo, Mode=TwoWay}" 
                      Width="200"/>

            <Button Content="OK" Command="{Binding ConfirmCommand}" 
                    Margin="10" Width="100"/>
        </StackPanel>
    </Grid>
</Window>
