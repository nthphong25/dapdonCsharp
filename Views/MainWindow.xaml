<Window
    x:Class="dapdon.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="EPC Viewer"
    Width="1200"
    Height="600"
    MinWidth="600"
    MinHeight="300"
    SizeToContent="Manual">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  Hàng chứa nút và logo  -->
            <RowDefinition Height="*" />
            <!--  Hàng chứa DataGrid  -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <!--  Cột chính chứa DataGrid  -->
            <ColumnDefinition Width="Auto" />
            <!--  Cột chứa logo  -->
        </Grid.ColumnDefinitions>

        <!--  Nút Refresh  -->
        <Button
            Grid.Column="0"
            Width="123"
            Height="70"
            Margin="10,0,0,0"
            Padding="5"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Background="#FFF94545"
            Click="BtnRefresh_Click"
            Content="Clear"
            Cursor="Hand"
            FontFamily="Arial"
            FontSize="25"
            Foreground="White">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
            
        </Button>
        <TextBlock
            HorizontalAlignment="Center"
            FontFamily="Arial"
            FontSize="55"
            Text="Đập đơn" />
        <!--  Logo (Dùng Stretch để tự điều chỉnh kích thước)  -->
        <Image
            Grid.Row="0"
            Height="70"
            Margin="907,10,63,10"
            Source="C:\Users\Administrator\source\repos\dapdon\Images\logo.png"
            Stretch="Uniform" />

        <!--  Bảng hiển thị tổng hợp theo MO  -->
        <DataGrid
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            AutoGenerateColumns="False"
            Background="{x:Null}"
            CanUserAddRows="False"
            FontSize="18"
            HeadersVisibility="Column"
            ItemsSource="{Binding MoSummaryList}"
            SelectionChanged="DataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding MoNo}"
                    Header="Mã MO" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding shoestyle_codefactory}"
                    Header="Số lượng EPC" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding mat_code}"
                    Header="Số lượng EPC" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding EpcCount}"
                    Header="Số lượng EPC" />

                <!--  Cột chứa Button  -->
                <DataGridTemplateColumn Width="150" Header="Chi tiết">
                    <!--  Tăng chiều rộng cột  -->
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button
                                Height="40"
                                Margin="3"
                                Padding="9"
                                Background="#31d097"
                                Command="{Binding DataContext.ShowEpcDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>

                                <!--  Đặt StackPanel đúng vị trí trong Button  -->
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <Image
                                        Width="20"
                                        Height="20"
                                        Margin="0,0,5,0"
                                        Source="C:\Users\Administrator\source\repos\dapdon\Images\change.png" />
                                    <TextBlock
                                        FontWeight="Bold"
                                        Foreground="Black"
                                        Text="Tranfer" />
                                </StackPanel>
                            </Button>

                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
